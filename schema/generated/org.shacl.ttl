@prefix jgkgcore: <http://localhost:8080/kg/def/core#> .
@prefix jgkgorg: <http://localhost:8080/kg/def/org#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

jgkgcore:Concept a sh:NodeShape ;
    rdfs:comment "「何について」の軸。主題・指標・制度手続きの上位" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:prefLabel ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jgkgcore:id ] ;
    sh:targetClass jgkgcore:Concept .

jgkgcore:Entity a sh:NodeShape ;
    rdfs:comment "本KGが扱うすべての事物の基底" ;
    sh:closed false ;
    sh:ignoredProperties ( jgkgcore:occurred_on rdf:type jgkgorg:organizationKindCode jgkgcore:unresolved_reason jgkgorg:cityName jgkgcore:amount_jpy jgkgorg:ministryCode jgkgcore:unresolved_key jgkgcore:unresolved_text jgkgorg:prefectureName jgkgcore:involves_agent jgkgorg:houjinBangou ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:prefLabel ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jgkgcore:id ] ;
    sh:targetClass jgkgcore:Entity .

jgkgcore:Event a sh:NodeShape ;
    rdfs:comment "「いつ」の軸。時点を持つ出来事。関係を実体化するための中心クラス。 「AがBに影響した」を直接のエッジにせず、原則としてこのクラスを介す" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jgkgcore:Agent ;
            sh:description "この出来事に関与した主体"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path jgkgcore:involves_agent ],
        [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:date ;
            sh:description "この出来事が起きた日"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jgkgcore:occurred_on ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path jgkgcore:id ] ;
    sh:targetClass jgkgcore:Event .

jgkgcore:MonetaryItem a sh:NodeShape ;
    rdfs:comment "「いくらで」の軸。予算科目・支出の上位" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path jgkgcore:id ],
        [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:integer ;
            sh:description "金額(円)"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jgkgcore:amount_jpy ] ;
    sh:targetClass jgkgcore:MonetaryItem .

jgkgcore:Place a sh:NodeShape ;
    rdfs:comment "「どこで」の軸。行政区域・住所・地物の上位" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:prefLabel ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jgkgcore:id ] ;
    sh:targetClass jgkgcore:Place .

jgkgcore:UnresolvedReference a sh:NodeShape ;
    rdfs:comment "正準IDに解決できなかった参照。設計書§8.2により、未解決を沈黙させず KGに残して計測できるようにするためのクラス" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path jgkgcore:id ],
        [ sh:description "解決できなかった理由"@ja ;
            sh:in ( "NO_CANDIDATE" "AMBIGUOUS" "OBSOLETE_ORGANIZATION" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path jgkgcore:unresolved_reason ],
        [ sh:datatype xsd:string ;
            sh:description "解決できなかった参照の、ソース側のキー(府省コード等)。ドメイン固有の プロパティを UnresolvedReference に足すと閉じたSHACLシェイプに違反するため、 汎用のキーとしてここで受ける"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jgkgcore:unresolved_key ],
        [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path skos:prefLabel ],
        [ sh:datatype rdf:langString ;
            sh:description "正準IDに解決できなかった元の参照文字列"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jgkgcore:unresolved_text ] ;
    sh:targetClass jgkgcore:UnresolvedReference .

jgkgcore:Work a sh:NodeShape ;
    rdfs:comment "「何を」の軸。法令・政策・事業・文書・司法判断の上位" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jgkgcore:id ],
        [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:prefLabel ] ;
    sh:targetClass jgkgcore:Work .

jgkgorg:GovernmentOrgan a sh:NodeShape ;
    rdfs:comment "法人種別が国の機関である組織" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type jgkgorg:ministryCode ) ;
    sh:property [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path jgkgcore:id ],
        [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path skos:prefLabel ],
        [ sh:datatype rdf:langString ;
            sh:description "所在地の都道府県名"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jgkgorg:prefectureName ],
        [ sh:datatype rdf:langString ;
            sh:description "所在地の市区町村名"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jgkgorg:cityName ],
        [ sh:datatype xsd:string ;
            sh:description "国税庁が付与する13桁の法人番号。組織の正準ID。 required にしないのは、出典管理のためグラフをソース別に分けており、 1つのエンティティの記述が複数グラフに分かれるため。SHACL検証はグラフ単位 (グラフが置換の単位)なので、グラフを跨いだ必須制約は原理的に検証できない。 「全Organizationが法人番号を持つ」ことはCQのSPARQLテストで担保する"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jgkgorg:houjinBangou ;
            sh:pattern "^\\d{13}$" ],
        [ sh:datatype xsd:string ;
            sh:description "法人番号公表サイトの法人種別コード"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jgkgorg:organizationKindCode ] ;
    sh:targetClass jgkgorg:GovernmentOrgan .

jgkgorg:Ministry a sh:NodeShape ;
    rdfs:comment "府省。府省コードで識別できる国の機関" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "法人番号公表サイトの法人種別コード"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jgkgorg:organizationKindCode ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path jgkgcore:id ],
        [ sh:datatype xsd:string ;
            sh:description "GIFコードリストの府省コード"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jgkgorg:ministryCode ],
        [ sh:datatype rdf:langString ;
            sh:description "所在地の都道府県名"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jgkgorg:prefectureName ],
        [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path skos:prefLabel ],
        [ sh:datatype rdf:langString ;
            sh:description "所在地の市区町村名"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path jgkgorg:cityName ],
        [ sh:datatype xsd:string ;
            sh:description "国税庁が付与する13桁の法人番号。組織の正準ID。 required にしないのは、出典管理のためグラフをソース別に分けており、 1つのエンティティの記述が複数グラフに分かれるため。SHACL検証はグラフ単位 (グラフが置換の単位)なので、グラフを跨いだ必須制約は原理的に検証できない。 「全Organizationが法人番号を持つ」ことはCQのSPARQLテストで担保する"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jgkgorg:houjinBangou ;
            sh:pattern "^\\d{13}$" ] ;
    sh:targetClass jgkgorg:Ministry .

jgkgorg:Organization a sh:NodeShape ;
    rdfs:comment "法人番号を持つ組織" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type jgkgorg:ministryCode ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:description "所在地の市区町村名"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path jgkgorg:cityName ],
        [ sh:datatype xsd:string ;
            sh:description "法人番号公表サイトの法人種別コード"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path jgkgorg:organizationKindCode ],
        [ sh:datatype rdf:langString ;
            sh:description "所在地の都道府県名"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jgkgorg:prefectureName ],
        [ sh:datatype xsd:string ;
            sh:description "国税庁が付与する13桁の法人番号。組織の正準ID。 required にしないのは、出典管理のためグラフをソース別に分けており、 1つのエンティティの記述が複数グラフに分かれるため。SHACL検証はグラフ単位 (グラフが置換の単位)なので、グラフを跨いだ必須制約は原理的に検証できない。 「全Organizationが法人番号を持つ」ことはCQのSPARQLテストで担保する"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jgkgorg:houjinBangou ;
            sh:pattern "^\\d{13}$" ],
        [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path skos:prefLabel ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path jgkgcore:id ] ;
    sh:targetClass jgkgorg:Organization .

jgkgcore:Agent a sh:NodeShape ;
    rdfs:comment "「誰が」の軸。行為の主体。組織と人の上位" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type jgkgorg:organizationKindCode jgkgorg:cityName jgkgorg:ministryCode jgkgorg:prefectureName jgkgorg:houjinBangou ) ;
    sh:property [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jgkgcore:id ],
        [ sh:datatype rdf:langString ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:prefLabel ] ;
    sh:targetClass jgkgcore:Agent .

