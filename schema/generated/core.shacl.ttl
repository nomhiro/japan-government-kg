@prefix jgkgcore: <http://localhost:8080/kg/def/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

jgkgcore:Concept a sh:NodeShape ;
    rdfs:comment "「何について」の軸。主題・指標・制度手続きの上位" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:prefLabel ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jgkgcore:id ] ;
    sh:targetClass jgkgcore:Concept .

jgkgcore:Entity a sh:NodeShape ;
    rdfs:comment "本KGが扱うすべての事物の基底" ;
    sh:closed false ;
    sh:ignoredProperties ( jgkgcore:unresolved_reason jgkgcore:unresolved_text jgkgcore:amount_jpy jgkgcore:unresolved_key rdf:type jgkgcore:involves_agent jgkgcore:occurred_on ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:prefLabel ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jgkgcore:id ] ;
    sh:targetClass jgkgcore:Entity .

jgkgcore:Event a sh:NodeShape ;
    rdfs:comment "「いつ」の軸。時点を持つ出来事。関係を実体化するための中心クラス。 「AがBに影響した」を直接のエッジにせず、原則としてこのクラスを介す" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class jgkgcore:Agent ;
            sh:description "この出来事に関与した主体"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path jgkgcore:involves_agent ],
        [ sh:datatype xsd:string ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path skos:prefLabel ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path jgkgcore:id ],
        [ sh:datatype xsd:date ;
            sh:description "この出来事が起きた日"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jgkgcore:occurred_on ] ;
    sh:targetClass jgkgcore:Event .

jgkgcore:MonetaryItem a sh:NodeShape ;
    rdfs:comment "「いくらで」の軸。予算科目・支出の上位" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:integer ;
            sh:description "金額(円)"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jgkgcore:amount_jpy ],
        [ sh:datatype xsd:string ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path skos:prefLabel ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path jgkgcore:id ] ;
    sh:targetClass jgkgcore:MonetaryItem .

jgkgcore:Place a sh:NodeShape ;
    rdfs:comment "「どこで」の軸。行政区域・住所・地物の上位" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:prefLabel ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jgkgcore:id ] ;
    sh:targetClass jgkgcore:Place .

jgkgcore:UnresolvedReference a sh:NodeShape ;
    rdfs:comment "正準IDに解決できなかった参照。設計書§8.2により、未解決を沈黙させず KGに残して計測できるようにするためのクラス" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "解決できなかった理由"@ja ;
            sh:in ( "NO_CANDIDATE" "AMBIGUOUS" "OBSOLETE_ORGANIZATION" ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path jgkgcore:unresolved_reason ],
        [ sh:datatype xsd:string ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path skos:prefLabel ],
        [ sh:datatype xsd:string ;
            sh:description "正準IDに解決できなかった元の参照文字列"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path jgkgcore:unresolved_text ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path jgkgcore:id ],
        [ sh:datatype xsd:string ;
            sh:description "解決できなかった参照の、ソース側のキー(府省コード等)。ドメイン固有の プロパティを UnresolvedReference に足すと閉じたSHACLシェイプに違反するため、 汎用のキーとしてここで受ける"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path jgkgcore:unresolved_key ] ;
    sh:targetClass jgkgcore:UnresolvedReference .

jgkgcore:Work a sh:NodeShape ;
    rdfs:comment "「何を」の軸。法令・政策・事業・文書・司法判断の上位" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:prefLabel ],
        [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jgkgcore:id ] ;
    sh:targetClass jgkgcore:Work .

jgkgcore:Agent a sh:NodeShape ;
    rdfs:comment "「誰が」の軸。行為の主体。組織と人の上位" ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:description "このリソースのURI"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path jgkgcore:id ],
        [ sh:datatype xsd:string ;
            sh:description "人間が読む名称"@ja ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path skos:prefLabel ] ;
    sh:targetClass jgkgcore:Agent .

