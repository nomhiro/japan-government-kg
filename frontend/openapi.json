  "info": {
    "title": "Japan Government KG API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/chat": {
      "post": {
        "operationId": "chat_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat"
      }
    },
    "/entity/{entity_id}": {
      "get": {
        "operationId": "entity_detail_entity__entity_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "entity_id",
            "required": true,
            "schema": {
              "title": "Entity Id",
              "type": "string"
            }
          },
          {
            "description": "関係一覧の既定50・最大200。超過は422で拒否する",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "関係一覧の既定50・最大200。超過は422で拒否する",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Entity Detail"
      }
    },
    "/neighborhood/{entity_id}": {
      "get": {
        "operationId": "neighborhood_neighborhood__entity_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "entity_id",
            "required": true,
            "schema": {
              "title": "Entity Id",
              "type": "string"
            }
          },
          {
            "description": "深さ。既定1・最大2(仕様§9.1が「深さ1-2」と定めている)。超過は422で拒否する(黙って丸めない)",
            "in": "query",
            "name": "depth",
            "required": false,
            "schema": {
              "default": 1,
              "description": "深さ。既定1・最大2(仕様§9.1が「深さ1-2」と定めている)。超過は422で拒否する(黙って丸めない)",
              "maximum": 2,
              "minimum": 1,
              "title": "Depth",
              "type": "integer"
            }
          },
          {
            "description": "総ノード数の上限。既定100・最大500",
            "in": "query",
            "name": "node_limit",
            "required": false,
            "schema": {
              "default": 100,
              "description": "総ノード数の上限。既定100・最大500",
              "maximum": 500,
              "minimum": 1,
              "title": "Node Limit",
              "type": "integer"
            }
          },
          {
            "description": "総エッジ数の上限。既定200・最大1000",
            "in": "query",
            "name": "edge_limit",
            "required": false,
            "schema": {
              "default": 200,
              "description": "総エッジ数の上限。既定200・最大1000",
              "maximum": 1000,
              "minimum": 1,
              "title": "Edge Limit",
              "type": "integer"
            }
          },
          {
            "description": "**1ノードあたりの分岐数の上限。** 総数の上限だけではハブ1個が予算を食い潰し、他の方向が1つも見えなくなる(既定25・最大100)",
            "in": "query",
            "name": "fanout_limit",
            "required": false,
            "schema": {
              "default": 25,
              "description": "**1ノードあたりの分岐数の上限。** 総数の上限だけではハブ1個が予算を食い潰し、他の方向が1つも見えなくなる(既定25・最大100)",
              "maximum": 100,
              "minimum": 1,
              "title": "Fanout Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NeighborhoodResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Neighborhood"
      }
    },
    "/overview": {
      "get": {
        "description": "トップページ第1層(裁定B103)。起動時に1回計算した値を返すだけ\n——リクエストごとにCQを走らせない(`overview.py`のモジュール\ndocstring参照)。\n\n`app.state.overview`が`None`なら**503**を返す。`/chat`が\n`chat_model`未設定のときに503を返すのと同じ作法(このモジュール\ndocstring参照)——起動時の集約に失敗しても、他のエンドポイントの\n起動を妨げない設計の裏返しである。\n\n**`getattr`で守る(レビュー要修正14)。** `app.state.overview`を\n直接読むと、`lifespan`が走っていない(`with`を付けない\n`TestClient(app)`等)状態で`AttributeError`になり、意図した503\nではなく500が返る——既存テストは全て`with`を使うので今は表に\n出ないが、`getattr(app.state, \"overview\", None)`にすれば\nlifespan未実行の状態でも意図した503に収束する。",
        "operationId": "overview_overview_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Overview"
      }
    },
    "/path": {
      "get": {
        "operationId": "path_path_get",
        "parameters": [
          {
            "description": "始点の`id_path`(`/entity/`と同じ形)",
            "in": "query",
            "name": "from",
            "required": true,
            "schema": {
              "description": "始点の`id_path`(`/entity/`と同じ形)",
              "minLength": 1,
              "title": "From",
              "type": "string"
            }
          },
          {
            "description": "終点の`id_path`(`/entity/`と同じ形)",
            "in": "query",
            "name": "to",
            "required": true,
            "schema": {
              "description": "終点の`id_path`(`/entity/`と同じ形)",
              "minLength": 1,
              "title": "To",
              "type": "string"
            }
          },
          {
            "description": "探索の深さ。既定4(法令→府省→事業→支出→法人の縦スライスが4ホップ)・最大6。超過は422で拒否する",
            "in": "query",
            "name": "max_depth",
            "required": false,
            "schema": {
              "default": 4,
              "description": "探索の深さ。既定4(法令→府省→事業→支出→法人の縦スライスが4ホップ)・最大6。超過は422で拒否する",
              "maximum": 6,
              "minimum": 1,
              "title": "Max Depth",
              "type": "integer"
            }
          },
          {
            "description": "訪問ノード数の予算。既定400・最大2000。**使い切ったら`budget_exhausted`が真になり、`found=false`は「無い」ではなく「見つからなかった」を意味する**",
            "in": "query",
            "name": "visit_budget",
            "required": false,
            "schema": {
              "default": 400,
              "description": "訪問ノード数の予算。既定400・最大2000。**使い切ったら`budget_exhausted`が真になり、`found=false`は「無い」ではなく「見つからなかった」を意味する**",
              "maximum": 2000,
              "minimum": 2,
              "title": "Visit Budget",
              "type": "integer"
            }
          },
          {
            "description": "1ノードあたりの分岐数の上限。既定50・最大200。**これが効くと探索は不完全になり`exhaustive`は真になれない**",
            "in": "query",
            "name": "fanout_limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "1ノードあたりの分岐数の上限。既定50・最大200。**これが効くと探索は不完全になり`exhaustive`は真になれない**",
              "maximum": 200,
              "minimum": 1,
              "title": "Fanout Limit",
