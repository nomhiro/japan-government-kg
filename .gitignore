# Claude Code のローカル作業ディレクトリ(worktree等)
.claude/worktrees/
.claude/settings.local.json

# 生データレイク・生成物(設計書§6.1)
# 取得したスナップショットと生成RDFはリポジトリに入れない
data/raw/
data/lake/
data/artifact/
data/quarantine/
data/snapshots/
data/generated/
*.zip
*.n3
*.nt
*.ttl.gz

# LinkML の生成物は「あえてコミットする」(設計書§5.1)
# 生成物をコミットすることが LinkML 採用を可逆にする唯一の措置であり、
# 差分レビューで生成器の回帰も検出できる。ここで除外してはならない。
# schema/generated/  ← 意図的に無視しない

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / フロントエンド
node_modules/
dist/
.vite/
*.tsbuildinfo

# 環境変数・秘匿情報
.env
.env.*
!.env.example

# Docker / Fuseki の永続データ
fuseki-data/
*.tdb

# OS / エディタ
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# 静的配信物。正は schema/generated/ なので同じものを2箇所にコミットしない
site/def/
site/sitemap.txt
# 最終レビュー要修正1(裁定B40): _headers も build-site.sh が made から
# 生成する(手書きのワイルドカードをやめた)。正は schema/generated/ 側
site/_headers

# アプリ(裁定B81)のビルド成果物。正は frontend/(ソース)。
# site.sync_app() が frontend/dist/ から書く——index.html はもう手書きの
# 静的ページではない(そちらは templates/def-index.html に移した)
site/index.html
site/assets/

# wrangler のローカル実行が作る一時ファイル
.wrangler/

# Playwright MCP(ブラウザ操作ツール)がセッションごとに作る作業ディレクトリ。
# 一次資料調査(SPAページのレンダリング)等で使うたびに生成され、内容に
# 再現性・保存価値が無い。B-2でmanifestにgit_commit/git_dirtyを記録する
# ようになったため、これを無視しないと「毎回dirty」という嘘の記録になる
.playwright-mcp/
