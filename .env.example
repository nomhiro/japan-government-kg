# ベースURI。ドメイン確定まで開発用のまま使う(設計書§4.2)
# 確定するまでKGを外部に公開しない
#
# **ここを書き換えても生成物(schema/generated/**)は追随しない。**
# ドメインを確定したら、この値を編集するのではなく次を実行する:
#     uv run python -m jgkg.base_uri https://<確定したドメイン>/kg
#     ./scripts/generate-schema.sh
# 追随していない状態は `uv run python -m jgkg.base_uri --check` が検出する
JGKG_BASE_URI=https://jgkg.norr-tech.com

# Apache Jena のバージョン。TDB2のオンディスク形式に紐づくため固定する
# 最初の実行時に現行安定版を確認して設定し、manifestに記録される
JENA_VERSION=6.2.0

# 法人番号 全件データのURL(2026-08-23 実測で確定した形):
#
#   https://www.houjin-bangou.nta.go.jp/download/zenken/index.html?event=download&selDlFileNo=<番号>
#
# ページのリンクは doDownload(<番号>) というJSだが、**同じ番号を selDlFileNo に
# 入れた単純GETで取得できる**(トークン不要。実測済み)。応答はzip
# (中身: 00_zenkoku_all_YYYYMMDD.csv 約1.26GB + 同名.ascのPGP署名)。
#
# **番号は月次の データ更新ごとに変わる。** 毎月、ダウンロードページ
# ( https://www.houjin-bangou.nta.go.jp/download/zenken/ )で
# 「全国・CSV形式・Unicode」の行の doDownload の番号を確認して更新する。
# Shift-JIS版を指定しないこと(ソースレジストリは encoding=utf-8 で登録している。
# 誤って指定しても errors=strict が止める)。
JGKG_HOUJIN_BANGOU_URL=
